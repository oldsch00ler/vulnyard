# Vulnyard configuration. Copy to .env and fill in the values you need.
# Never commit .env – it is in .gitignore.

# --- Required -----------------------------------------------------------------
# PostgreSQL connection. Both postgres:// and postgresql:// are accepted and
# normalised to postgresql+asyncpg://.
# docker compose points the app at its own postgres service, so leave this
# commented out there. Uncomment it when running the app outside compose, or to
# use a database of your own.
#DATABASE_URL=postgresql://vulnyard:vulnyard@localhost:5432/vulnyard

# --- Repository source (required for scanning) --------------------------------
# Self-hosted GitLab or https://gitlab.com
GITLAB_URL=https://gitlab.com
# Group or project access token: role Reporter, scopes read_api + read_repository
GITLAB_TOKEN=

# --- Dependency-Track (required for scanning) --------------------------------
# Base URL of the API, without /api/v1
DT_API_URL=
# API key of a team in Dependency-Track
DT_API_KEY=
# URL of the Dependency-Track UI for links; defaults to DT_API_URL
DT_UI_URL=

# --- Identity ----------------------------------------------------------------
# none = no identity (run the app behind a VPN or another protection layer)
# proxy-header = identity comes from an authenticating reverse proxy
AUTH_MODE=none
# Headers carrying the identity in proxy-header mode, in order of priority
AUTH_HEADERS=X-Forwarded-Email,X-Forwarded-User

# --- Scanning ----------------------------------------------------------------
# Number of parallel scans
SCAN_CONCURRENCY=2
# Timeout of a single scan (clone + Trivy) in seconds
SCAN_TIMEOUT_SECONDS=900
# Explicit path to the Trivy binary; otherwise ./.bin/trivy and PATH are tried
TRIVY_BIN=
# true = run Trivy with --offline-scan (environments without internet access)
TRIVY_OFFLINE=false
# Path to a PEM file with a custom CA (GitLab/Dependency-Track behind an
# internal certificate); used for HTTP calls, git and Trivy
CA_BUNDLE=

# --- Runtime -----------------------------------------------------------------
# Timezone of the scheduler and of displayed timestamps
TZ=UTC
# Language of the log and chat messages, and of the UI until a user picks one.
# Any locale with a catalogue in app/i18n (cs, en, ...)
DEFAULT_LOCALE=cs
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Port uvicorn listens on (the platform usually sets this)
PORT=8000

# --- docker compose only -----------------------------------------------------
# Released image to run instead of building from the checkout, e.g.
# ghcr.io/oldsch00ler/vulnyard:1.2.3 (then: docker compose pull &&
# docker compose up -d --no-build). Pin a version rather than :latest.
#VULNYARD_IMAGE=
# Host port the app is published on
APP_PORT=8000
# Credentials of the bundled PostgreSQL
POSTGRES_USER=vulnyard
POSTGRES_PASSWORD=vulnyard
POSTGRES_DB=vulnyard
# Ports of the optional dtrack profile
DTRACK_API_PORT=8081
DTRACK_UI_PORT=8082
